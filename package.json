{
  "name": "threadglyph",
  "version": "0.3.0",
  "private": true,
  "description": "Editable comment threads anchored to text in Obsidian notes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run build",
    "sandbox": "node scripts/sandbox-vault.mjs",
    "sandbox:pull": "node scripts/sandbox-pull-production.mjs",
    "package": "node scripts/package.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "uat": "node ../obsidian-uat/cli.mjs run",
    "uat:review": "node ../obsidian-uat/cli.mjs review",
    "uat:feedback": "node ../obsidian-uat/cli.mjs feedback",
    "uat:status": "node ../obsidian-uat/cli.mjs status",
    "uat:stop": "node ../obsidian-uat/cli.mjs stop"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.13.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^5.0.5"
  }
}
